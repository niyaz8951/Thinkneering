{
  "name": "thinkneering-hub",
  "version": "1.0.0",
  "private": true,
  "description": "DAME Tools Hub on Cloudflare: one Worker serving the site and its API, D1 for data, R2 for files, Workers AI for drafting.",
  "type": "module",
  "scripts": {
    "dev": "node scripts/dev-seed.mjs && wrangler dev --port 8787",
    "dev:fresh": "node scripts/dev-seed.mjs --fresh && wrangler dev --port 8787",
    "dev:offline": "node scripts/dev-seed.mjs && wrangler dev --env local --port 8787",
    "migrate:local": "wrangler d1 migrations apply DB --local",
    "migrate:remote": "wrangler d1 migrations apply DB --remote",
    "seed:local": "node scripts/dev-seed.mjs --fresh",
    "test": "vitest run && node scripts/rows-parity.mjs && node scripts/ds-parse-check.mjs && node scripts/mp-water-check.mjs && node scripts/mp-signs-check.mjs",
    "test:parity": "node scripts/rows-parity.mjs",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "typecheck": "tsc --noEmit",
    "deploy": "wrangler d1 migrations apply DB --remote && wrangler deploy",
    "reindex": "node scripts/reindex.mjs",
    "export": "node scripts/export-d1.mjs"
  },
  "devDependencies": {
    "@cloudflare/vitest-plugin": "^1.4.2",
    "@cloudflare/workers-types": "^5.20261014.1",
    "@playwright/test": "^1.58.0",
    "@types/node": "^22.20.5",
    "typescript": "^5.9.0",
    "vitest": "^4.1.0",
    "wrangler": "^4.151.0"
  },
  "dependencies": {
    "bcryptjs": "^3.0.3"
  }
}
