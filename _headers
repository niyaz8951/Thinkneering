# The service worker must not be cached, or a fixed worker can be pinned in
# place by the very cache it manages. Everything under /assets/ is versioned
# with ?v= in the markup, so it can be cached hard and for a long time.

/sw.js
  Cache-Control: no-cache

/manifest.webmanifest
  Cache-Control: public, max-age=3600

/assets/*
  Cache-Control: public, max-age=31536000, immutable

/assets/icons/*
  Cache-Control: public, max-age=604800
